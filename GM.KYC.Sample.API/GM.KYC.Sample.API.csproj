<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!--
      References the sibling GM.KYC source repo by project path so the sample builds against current
      code. Once the KYC packages are published, swap these for PackageReference 1.0.0.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\GM.KYC\GM.KYC\GM.KYC.csproj" />
        <ProjectReference Include="..\..\GM.KYC\GM.KYC.Identomat\GM.KYC.Identomat.csproj" />
        <ProjectReference Include="..\..\GM.KYC\GM.KYC.Persistence\GM.KYC.Persistence.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GM.FileStorage.Local" Version="1.1.0" />
        <PackageReference Include="GM.Caching" Version="1.0.0" />
        <PackageReference Include="GM.DistributedLock" Version="1.0.0" />
        <PackageReference Include="GM.Idempotency" Version="1.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    </ItemGroup>

</Project>
